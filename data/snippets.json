[ 
  {
    "label": "Text Abschnitt",
    "key": "text-section",
    "snippet": "<section class=\"block block-text\">{{#title}}<h2>{{title}}</h2>{{/title}}<div class=\"text-content\">{{{text}}}</div></section>",
    "type": "free"
  },
  {
    "label": "Abschnitt Kopf",
    "key": "section-heading",
