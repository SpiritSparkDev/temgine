    "type": "free"
  },
  {
    "label": "Artikel Text",
    "key": "article-text",
    "snippet": "<article class=\"text_article\">{{#title}}<h2>{{title}}</h2>{{/title}}<p>{{text}}</p></article>",
    "type": "free"
  },
  {
    "label": "Artikel mit Bild",
    "key": "article-with-image",
    "snippet": "<article class=\"text_article\">{{heading}}<p>{{text}}</p><div class=\"article-image\"><img src=\"{{imgUrl}}\" alt=\"{{alt_text}}\" /></div></article>",
    "type": "free"
  },
  {
    "label": "Excerpt Zeile",
    "key": "excerpt-text",
    "snippet": "<p class=\"excerpt\">{{data.excerpt}}</p>",
    "type": "free"
  },
  {
    "label": "CTA Link",
    "key": "cta-link",
