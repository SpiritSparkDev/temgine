# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32

# Setup-Token für die Ersteinrichtung (/setup) — OPTIONAL.
# Wenn nicht gesetzt, generiert der Server beim Start selbst einen Token
# und gibt einen fertigen Klick-Link in der Konsole aus. Nur explizit
# setzen, wenn mehrere Server-Instanzen denselben Token teilen müssen.
# SETUP_TOKEN=

# GitHub OAuth
GITHUB_ID=your-github-oauth-app-client-id
GITHUB_SECRET=your-github-oauth-app-client-secret

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=125154412206-0fnrlmf45v5cd8d1ao6oie3s9u6s66sp.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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


# Database
DATABASE_URL=postgres://postgres:148635-Tls@localhost:5432/temgine
# Für Docker:
DATABASE_USER=temgine
DATABASE_PASSWORD=temgine_dev
DATABASE_NAME=temgine
DATABASE_PORT=5432

# SMTP (Kontaktformular / Member-E-Mails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=yourpassword
SMTP_FROM=noreply@yourdomain.com
# SMTP_SECURE=false  # true für Port 465 (SSL), false für Port 587 (STARTTLS)

# Kontaktformular-Empfänger (Fallback falls nicht in den Admin-Einstellungen konfiguriert)
CONTACT_MAIL_TO=admin@yourdomain.com

