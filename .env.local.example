# NextAuth Configuration
# Unter Docker wird dieser Wert automatisch überschrieben (folgt APP_PORT bzw.
# PUBLIC_URL, siehe development_docs/DOCKER.md) — hier nur für lokalen
# Dev-Betrieb / Plesk relevant.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32

# GitHub OAuth (Optional)
GITHUB_ID=your-github-oauth-app-client-id
GITHUB_SECRET=your-github-oauth-app-client-secret

# Database
# Einzige Quelle für DB-Zugangsdaten — gilt für lokalen Dev-Betrieb, Plesk UND
# Docker (npm run docker:up liest User/Passwort/DB-Name automatisch aus dieser
# URL heraus, siehe development_docs/DOCKER.md).
DATABASE_URL=postgresql://USER:PASS@localhost:5432/temgine_cms

# SMTP (Kontaktformular / Member-E-Mails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=yourpassword
SMTP_FROM=noreply@yourdomain.com
# SMTP_SECURE=false  # true für Port 465 (SSL), false für Port 587 (STARTTLS)

# Kontaktformular-Empfänger (Fallback falls nicht in den Admin-Einstellungen konfiguriert)
CONTACT_MAIL_TO=admin@yourdomain.com

# Spam-Schutz (Altcha) fürs Kontaktformular
# HMAC-Schlüssel zum Signieren/Prüfen der Challenge-Tokens. Unbedingt auf einen
# eigenen Zufallswert setzen (z. B. mit openssl rand -base64 32) — ohne diese
# Variable wird ein unsicherer Default-Wert verwendet.
ALTCHA_HMAC_KEY=your-random-altcha-secret-here

# Dev-Modus (optional, NUR für lokale Entwicklung — niemals in Produktion setzen!)
# DEV_MODE=true umgeht die komplette NextAuth-Authentifizierung (Middleware,
# Admin-Seite, requireAuth) und ist zusätzlich auf localhost/NODE_ENV!=production
# abgesichert. NEXT_PUBLIC_DEV_MODE ist das clientseitige Pendant (im Browser
# sichtbar) und schaltet Entwickler-Hinweise in der Admin-UI sowie den
# Import-Endpunkt frei.
# DEV_MODE=true
# NEXT_PUBLIC_DEV_MODE=true
# NEXT_PUBLIC_DEBUG_RENDER=true

# robots.txt (Optional — Defaults greifen, wenn nicht gesetzt)
# ROBOTS_DISALLOW=/admin,/api
# ROBOTS_CRAWL_DELAY=1
# ROBOTS_REQUEST_RATE=10/1m

