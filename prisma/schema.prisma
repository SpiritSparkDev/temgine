// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String           @id @default(cuid())
  email       String           @unique
  name        String?
  image       String?
  role        UserRole         @default(EDITOR)
  password    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  invitations UserInvitation[]
}

enum UserRole {
  ADMIN
  MODERATOR
  EDITOR
}

model UserInvitation {
  id        String    @id @default(cuid())
  name      String?
  role      UserRole  @default(EDITOR)
  token     String    @unique
  used      Boolean   @default(false)
  expiresAt DateTime
  createdBy String
  creator   User      @relation(fields: [createdBy], references: [id])
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  usedBy    String?
}

model Page {
  id                 String              @id @default(cuid())
  slug               String              @unique
  title              String
  blocks             Json                @default("[]")
  template           String?
  data               Json                @default("{}")
  children           Json                @default("[]")
  revisions          PageRevision[]
  workflowEvents     PageWorkflowEvent[]
  status             PageStatus          @default(DRAFT)
  publishAt          DateTime?
  isHomepage         Boolean             @default(false)
  accessGroups       Json                @default("[]")
  accessPasswordHash String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

enum PageStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
  SCHEDULED
}

model PageRevision {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  data      Json
  note      String?
  createdBy String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  resource   String
  resourceId String?
  userId     String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([resource, resourceId])
}

model Snippet {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum GlobalVarType {
  STRING
  NUMBER
  URL
  IMAGE
  DATE
  BOOLEAN
  ARRAY
  HTML
}

model GlobalVariable {
  id        String        @id @default(cuid())
  key       String        @unique
  label     String
  type      GlobalVarType @default(STRING)
  value     String        @db.Text
  fallback  String?       @db.Text
  isActive  Boolean       @default(true)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model ContentType {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String?
  fields      ContentField[]
  entries     ContentEntry[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model ContentField {
  id            String      @id @default(cuid())
  contentTypeId String
  contentType   ContentType @relation(fields: [contentTypeId], references: [id], onDelete: Cascade)
  name          String
  key           String
  type          String
  options       Json?
  required      Boolean     @default(false)
  sortOrder     Int         @default(0)
}

model ContentEntry {
  id            String      @id @default(cuid())
  contentTypeId String
  contentType   ContentType @relation(fields: [contentTypeId], references: [id], onDelete: Cascade)
  data          Json        @default("{}")
  title         String?
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([contentTypeId])
  @@index([contentTypeId, sortOrder])
}

model PageWorkflowEvent {
  id         String     @id @default(cuid())
  pageId     String
  page       Page       @relation(fields: [pageId], references: [id], onDelete: Cascade)
  fromStatus PageStatus
  toStatus   PageStatus
  comment    String?    @db.Text
  createdBy  String?
  createdAt  DateTime   @default(now())

  @@index([pageId])
}

model FileMetadata {
  id        String   @id @default(cuid())
  url       String   @unique
  altText   String?
  copyright String?
  caption   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([url])
}

// ── Contact Form ─────────────────────────────────────────────────────────────

model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String    @db.Text
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([createdAt])
}

// ── Member System ─────────────────────────────────────────────────────────────

model Member {
  id             String                  @id @default(cuid())
  email          String                  @unique
  name           String?
  password       String
  verified       Boolean                 @default(false)
  verifyToken    String?                 @unique
  verifyTokenExp DateTime?
  blocked        Boolean                 @default(false)
  groups         MemberGroupMembership[]
  shopOrders     ShopOrder[]
  wishlist       ShopWishlistItem[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([email])
}

model MemberGroup {
  id      String                  @id @default(cuid())
  name    String
  slug    String                  @unique
  members MemberGroupMembership[]

  @@index([slug])
}

model MemberGroupMembership {
  memberId String
  groupId  String
  member   Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  group    MemberGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([memberId, groupId])
}

// ── Blog / News ───────────────────────────────────────────────────────────────

enum PostStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
  SCHEDULED
}

model BlogChannel {
  id                    String     @id @default(cuid())
  name                  String
  slug                  String     @unique
  description           String?
  /// Template name for the detail-preview card (image, title, excerpt, date)
  templateDetailPreview String?
  /// Template name for the simple-preview card (title + short excerpt only)
  templateSimplePreview String?
  /// Template name for the archive entry (title + date only)
  templateArchiveEntry  String?
  /// Template name for the full reading/article page
  templateReading       String?
  /// Standard-Sortierung der Beiträge (Spalte oder Template-Feld, z. B. "Beginn"), siehe lib/blogPostQuery.js
  sortField             String?
  /// "asc" | "desc"
  sortDir               String?
  posts                 BlogPost[]
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
}

model BlogPost {
  id           String      @id @default(cuid())
  channelId    String
  channel      BlogChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  title        String
  slug         String
  excerpt      String?     @db.Text
  body         String?     @db.Text
  coverImage   String?
  author       String?
  status       PostStatus  @default(DRAFT)
  publishAt    DateTime?
  publishedAt  DateTime?
  templateData Json?
  /// Archivierte Beiträge bleiben per URL erreichbar, erscheinen aber nicht mehr in Kanal-Listen (außer archive=only|include)
  archived     Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([channelId, slug])
  @@index([channelId, status])
  @@index([channelId, publishedAt])
}

// ── Shop (Add-on) ─────────────────────────────────────────────────────────────
// Beträge in Cent (Int), Währung EUR. Steuersätze in Hundertstel-Prozent (700 = 7 %).
// null bei Preis/Steuersatz = Format ist (noch) nicht bestellbar. null beim Bestand = unbegrenzt.

enum ShopOrderStatus {
  PENDING
  PAID
  SHIPPED
  CANCELLED
  FAILED
  REFUNDED
}

enum ShopPaymentProvider {
  SUMUP
  STRIPE
  PAYPAL
}

enum ShopPaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

model ShopProduct {
  id           String             @id @default(cuid())
  slug         String             @unique
  title        String
  category     String?
  subtitle     String?
  shortText    String?
  description  String?            @db.Text
  /// Liste von Bild-URLs (z. B. "/uploads/shop/x.webp"); das erste Bild ist das Titelbild
  images       Json               @default("[]")
  /// Slugs verwandter Produkte ("Dazu passt")
  related      Json               @default("[]")
  /// Übersetzungen je Sprache: { en: { title, subtitle, shortText, description } }
  translations Json               @default("{}")
  wishlist     ShopWishlistItem[]
  active       Boolean            @default(false)
  sortOrder    Int                @default(0)
  formats      ShopFormat[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([active, sortOrder])
}

model ShopFormat {
  id          String            @id @default(cuid())
  productId   String
  product     ShopProduct       @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku         String            @unique
  label       String
  priceCents  Int?
  taxRateBp   Int?
  weightG     Int?
  stock       Int?
  digital     Boolean           @default(false)
  /// Staffelpreise: [{ minQty, priceCents }]
  priceTiers  Json?
  /// Bündel: [{ sku, qty }]; leer = normales Format
  bundleItems Json?
  sortOrder   Int               @default(0)
  items       ShopOrderItem[]
  files       ShopDigitalFile[]
  alerts      ShopStockAlert[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([productId, sortOrder])
}

model ShopOrder {
  id              String              @id @default(cuid())
  /// Laufende Nummer; daraus wird die Bestellnummer (reference) gebildet
  number          Int                 @unique @default(autoincrement())
  reference       String              @unique
  status          ShopOrderStatus     @default(PENDING)
  email           String
  billing         Json
  shipping        Json
  subtotalCents   Int
  shippingCents   Int
  totalCents      Int
  currency        String              @default("EUR")
  /// Enthaltene MwSt. je Satz in Cent, z. B. {"700": 326}
  taxBreakdown    Json                @default("{}")
  acceptedTermsAt DateTime
  acceptedWaiver  Boolean             @default(false)
  memberId        String?
  member          Member?             @relation(fields: [memberId], references: [id], onDelete: SetNull)
  paidAt          DateTime?
  shippedAt       DateTime?
  cancelledAt     DateTime?
  /// Geheimer Zugriffstoken für Bestellstatus, Downloads und Rechnung (Rückkehr-URL)
  accessToken     String?             @unique
  locale          String              @default("de")
  couponCode      String?
  discountCents   Int                 @default(0)
  shippingTaxBp   Int?
  trackingCarrier String?
  trackingNumber  String?
  trackingUrl     String?
  refundedCents   Int                 @default(0)
  invoice         ShopInvoice?
  refunds         ShopRefund[]
  events          ShopOrderEvent[]
  reservations    ShopReservation[]
  downloadTokens  ShopDownloadToken[]
  returns         ShopReturnRequest[]
  items           ShopOrderItem[]
  payments        ShopPayment[]
  stockMovements  ShopStockMovement[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model ShopOrderItem {
  id            String      @id @default(cuid())
  orderId       String
  order         ShopOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Bleibt leer, wenn das Format später gelöscht wird; die Felder darunter sind der Stand zum Kaufzeitpunkt
  formatId      String?
  format        ShopFormat? @relation(fields: [formatId], references: [id], onDelete: SetNull)
  sku           String
  title         String
  label         String
  qty           Int
  unitCents     Int
  taxRateBp     Int
  digital       Boolean     @default(false)
  weightG       Int?
  /// Anteil des Gutscheinrabatts an dieser Position
  discountCents Int         @default(0)
  /// Bündel-Bestandteile zum Kaufzeitpunkt: [{ formatId, sku, title, label, qty, digital, weightG }]
  bundleItems   Json?

  @@index([orderId])
}

model ShopPayment {
  id          String              @id @default(cuid())
  orderId     String
  order       ShopOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    ShopPaymentProvider
  /// Checkout-ID (SumUp), Checkout-Session-ID (Stripe) bzw. Order-ID (PayPal)
  externalId  String
  status      ShopPaymentStatus   @default(PENDING)
  amountCents Int
  currency    String              @default("EUR")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([provider, externalId])
  @@index([orderId])
}

/// Bestandsbuchungen. Die Eindeutigkeit (orderId, sku, reason) macht die Abbuchung je Bestellung idempotent.
model ShopStockMovement {
  id        String     @id @default(cuid())
  sku       String
  delta     Int
  reason    String
  orderId   String?
  order     ShopOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())

  @@unique([orderId, sku, reason])
  @@index([sku, createdAt])
}

// ── Shop, Erweiterungsrunde 2 ─────────────────────────────────────────────────

enum ShopRefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum ShopCouponType {
  PERCENT
  FIXED
}

enum ShopReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
}

enum ShopReturnStatus {
  NEW
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
}

/// Laufende Zähler (z. B. Rechnungsnummern je Jahr: key "invoice-2026")
model ShopCounter {
  key   String @id
  value Int    @default(0)
}

model ShopInvoice {
  id       String    @id @default(cuid())
  orderId  String    @unique
  order    ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  number   String    @unique
  issuedAt DateTime  @default(now())
  /// Snapshot zum Ausstellungszeitpunkt (Absenderdaten, Zahlungsart)
  data     Json      @default("{}")
}

model ShopRefund {
  id          String           @id @default(cuid())
  orderId     String
  order       ShopOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentId   String?
  amountCents Int
  reason      String?
  restock     Boolean          @default(false)
  status      ShopRefundStatus @default(PENDING)
  externalId  String?
  error       String?
  userId      String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([orderId])
}

model ShopOrderEvent {
  id        String    @id @default(cuid())
  orderId   String
  order     ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String
  message   String?   @db.Text
  userId    String?
  data      Json?
  createdAt DateTime  @default(now())

  @@index([orderId, createdAt])
}

model ShopCoupon {
  id            String          @id @default(cuid())
  code          String          @unique
  type          ShopCouponType
  /// PERCENT: Basispunkte (500 = 5 %), FIXED: Cent
  value         Int
  minOrderCents Int?
  maxUses       Int?
  usedCount     Int             @default(0)
  validFrom     DateTime?
  validUntil    DateTime?
  active        Boolean         @default(true)
  note          String?
  uses          ShopCouponUse[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

/// Eindeutig je Bestellung: macht die Zählung der Einlösung idempotent
model ShopCouponUse {
  id       String     @id @default(cuid())
  couponId String
  coupon   ShopCoupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  orderId  String     @unique
  usedAt   DateTime   @default(now())

  @@index([couponId])
}

model ShopReservation {
  id        String                @id @default(cuid())
  orderId   String
  order     ShopOrder             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  formatId  String
  qty       Int
  status    ShopReservationStatus @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime              @default(now())

  @@index([formatId, status, expiresAt])
  @@index([orderId])
}

model ShopDigitalFile {
  id         String              @id @default(cuid())
  formatId   String
  format     ShopFormat          @relation(fields: [formatId], references: [id], onDelete: Cascade)
  /// Anzeigename (bereinigt); gespeichert wird unter einem Zufallsnamen
  filename   String
  storedName String              @unique
  sizeBytes  Int
  mime       String?
  tokens     ShopDownloadToken[]
  createdAt  DateTime            @default(now())

  @@index([formatId])
}

model ShopDownloadToken {
  id             String          @id @default(cuid())
  orderId        String
  order          ShopOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fileId         String
  file           ShopDigitalFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  token          String          @unique
  expiresAt      DateTime
  maxDownloads   Int
  downloads      Int             @default(0)
  lastDownloadAt DateTime?
  createdAt      DateTime        @default(now())

  @@unique([orderId, fileId])
}

model ShopWishlistItem {
  memberId  String
  member    Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  productId String
  product   ShopProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@id([memberId, productId])
}

model ShopStockAlert {
  id               String     @id @default(cuid())
  formatId         String
  format           ShopFormat @relation(fields: [formatId], references: [id], onDelete: Cascade)
  email            String
  locale           String     @default("de")
  confirmToken     String     @unique
  unsubscribeToken String     @unique
  confirmedAt      DateTime?
  notifiedAt       DateTime?
  createdAt        DateTime   @default(now())

  @@unique([formatId, email])
}

model ShopReturnRequest {
  id        String           @id @default(cuid())
  orderId   String
  order     ShopOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  email     String
  /// [{ sku, qty }] oder leer = ganze Bestellung
  items     Json             @default("[]")
  reason    String           @db.Text
  status    ShopReturnStatus @default(NEW)
  adminNote String?          @db.Text
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([orderId])
  @@index([status, createdAt])
}
