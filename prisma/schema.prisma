// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String           @id @default(cuid())
  email       String           @unique
  name        String?
  image       String?
  role        UserRole         @default(EDITOR)
  password    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  invitations UserInvitation[]
}

enum UserRole {
  ADMIN
  MODERATOR
  EDITOR
}

model UserInvitation {
  id        String    @id @default(cuid())
  name      String?
  role      UserRole  @default(EDITOR)
  token     String    @unique
  used      Boolean   @default(false)
  expiresAt DateTime
  createdBy String
  creator   User      @relation(fields: [createdBy], references: [id])
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  usedBy    String?
}

model Page {
  id             String               @id @default(cuid())
  slug           String               @unique
  title          String
  blocks         Json                 @default("[]")
  template       String?
  data           Json                 @default("{}")
  children       Json                 @default("[]")
  revisions      PageRevision[]
  workflowEvents PageWorkflowEvent[]
  status         PageStatus           @default(DRAFT)
  publishAt      DateTime?
  isHomepage     Boolean              @default(false)
  accessGroups   Json                 @default("[]")
  accessPasswordHash String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

enum PageStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
  SCHEDULED
}

model PageRevision {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  data      Json
  note      String?
  createdBy String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  resource   String
  resourceId String?
  userId     String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([resource, resourceId])
}

model Snippet {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum GlobalVarType {
  STRING
  NUMBER
  URL
  IMAGE
  DATE
  BOOLEAN
  ARRAY
  HTML
}

model GlobalVariable {
  id        String        @id @default(cuid())
  key       String        @unique
  label     String
  type      GlobalVarType @default(STRING)
  value     String        @db.Text
  fallback  String?       @db.Text
  isActive  Boolean       @default(true)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model ContentType {
  id        String         @id @default(cuid())
  name      String
  slug      String         @unique
  description String?
  fields    ContentField[]
  entries   ContentEntry[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model ContentField {
  id          String   @id @default(cuid())
  contentTypeId String
  contentType ContentType @relation(fields: [contentTypeId], references: [id], onDelete: Cascade)
  name        String
  key         String
  type        String
  options     Json?
  required    Boolean  @default(false)
  sortOrder    Int      @default(0)
}

model ContentEntry {
  id            String   @id @default(cuid())
  contentTypeId String
  contentType   ContentType @relation(fields: [contentTypeId], references: [id], onDelete: Cascade)
  data          Json     @default("{}")
  title         String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([contentTypeId])
  @@index([contentTypeId, sortOrder])
}

model PageWorkflowEvent {
  id         String     @id @default(cuid())
  pageId     String
  page       Page       @relation(fields: [pageId], references: [id], onDelete: Cascade)
  fromStatus PageStatus
  toStatus   PageStatus
  comment    String?    @db.Text
  createdBy  String?
  createdAt  DateTime   @default(now())

  @@index([pageId])
}

model FileMetadata {
  id        String   @id @default(cuid())
  url       String   @unique
  altText   String?
  copyright String?
  caption   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([url])
}

// ── Contact Form ─────────────────────────────────────────────────────────────

model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String    @db.Text
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([createdAt])
}

// ── Member System ─────────────────────────────────────────────────────────────

model Member {
  id             String                  @id @default(cuid())
  email          String                  @unique
  name           String?
  password       String
  verified       Boolean                 @default(false)
  verifyToken    String?                 @unique
  verifyTokenExp DateTime?
  blocked        Boolean                 @default(false)
  groups         MemberGroupMembership[]
  shopOrders     ShopOrder[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([email])
}

model MemberGroup {
  id      String                  @id @default(cuid())
  name    String
  slug    String                  @unique
  members MemberGroupMembership[]

  @@index([slug])
}

model MemberGroupMembership {
  memberId String
  groupId  String
  member   Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  group    MemberGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([memberId, groupId])
}

// ── Blog / News ───────────────────────────────────────────────────────────────

enum PostStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
  SCHEDULED
}

model BlogChannel {
  id                    String     @id @default(cuid())
  name                  String
  slug                  String     @unique
  description           String?
  /// Template name for the detail-preview card (image, title, excerpt, date)
  templateDetailPreview String?
  /// Template name for the simple-preview card (title + short excerpt only)
  templateSimplePreview String?
  /// Template name for the archive entry (title + date only)
  templateArchiveEntry  String?
  /// Template name for the full reading/article page
  templateReading       String?
  /// Standard-Sortierung der Beiträge (Spalte oder Template-Feld, z. B. "Beginn"), siehe lib/blogPostQuery.js
  sortField             String?
  /// "asc" | "desc"
  sortDir               String?
  posts                 BlogPost[]
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
}

model BlogPost {
  id           String      @id @default(cuid())
  channelId    String
  channel      BlogChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  title        String
  slug         String
  excerpt      String?     @db.Text
  body         String?     @db.Text
  coverImage   String?
  author       String?
  status       PostStatus  @default(DRAFT)
  publishAt    DateTime?
  publishedAt  DateTime?
  templateData Json?
  /// Archivierte Beiträge bleiben per URL erreichbar, erscheinen aber nicht mehr in Kanal-Listen (außer archive=only|include)
  archived     Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([channelId, slug])
  @@index([channelId, status])
  @@index([channelId, publishedAt])
}

// ── Shop (Add-on) ─────────────────────────────────────────────────────────────
// Beträge in Cent (Int), Währung EUR. Steuersätze in Hundertstel-Prozent (700 = 7 %).
// null bei Preis/Steuersatz = Format ist (noch) nicht bestellbar. null beim Bestand = unbegrenzt.

enum ShopOrderStatus {
  PENDING
  PAID
  SHIPPED
  CANCELLED
  FAILED
}

enum ShopPaymentProvider {
  SUMUP
  STRIPE
  PAYPAL
}

enum ShopPaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

model ShopProduct {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  category    String?
  subtitle    String?
  shortText   String?
  description String?      @db.Text
  /// Liste von Bild-URLs (z. B. "/uploads/shop/x.webp"); das erste Bild ist das Titelbild
  images      Json         @default("[]")
  active      Boolean      @default(false)
  sortOrder   Int          @default(0)
  formats     ShopFormat[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([active, sortOrder])
}

model ShopFormat {
  id         String          @id @default(cuid())
  productId  String
  product    ShopProduct     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String          @unique
  label      String
  priceCents Int?
  taxRateBp  Int?
  weightG    Int?
  stock      Int?
  digital    Boolean         @default(false)
  sortOrder  Int             @default(0)
  items      ShopOrderItem[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([productId, sortOrder])
}

model ShopOrder {
  id              String              @id @default(cuid())
  /// Laufende Nummer; daraus wird die Bestellnummer (reference) gebildet
  number          Int                 @unique @default(autoincrement())
  reference       String              @unique
  status          ShopOrderStatus     @default(PENDING)
  email           String
  billing         Json
  shipping        Json
  subtotalCents   Int
  shippingCents   Int
  totalCents      Int
  currency        String              @default("EUR")
  /// Enthaltene MwSt. je Satz in Cent, z. B. {"700": 326}
  taxBreakdown    Json                @default("{}")
  acceptedTermsAt DateTime
  acceptedWaiver  Boolean             @default(false)
  memberId        String?
  member          Member?             @relation(fields: [memberId], references: [id], onDelete: SetNull)
  paidAt          DateTime?
  shippedAt       DateTime?
  items           ShopOrderItem[]
  payments        ShopPayment[]
  stockMovements  ShopStockMovement[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model ShopOrderItem {
  id        String      @id @default(cuid())
  orderId   String
  order     ShopOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Bleibt leer, wenn das Format später gelöscht wird; die Felder darunter sind der Stand zum Kaufzeitpunkt
  formatId  String?
  format    ShopFormat? @relation(fields: [formatId], references: [id], onDelete: SetNull)
  sku       String
  title     String
  label     String
  qty       Int
  unitCents Int
  taxRateBp Int
  digital   Boolean     @default(false)
  weightG   Int?

  @@index([orderId])
}

model ShopPayment {
  id          String              @id @default(cuid())
  orderId     String
  order       ShopOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    ShopPaymentProvider
  /// Checkout-ID (SumUp), Checkout-Session-ID (Stripe) bzw. Order-ID (PayPal)
  externalId  String
  status      ShopPaymentStatus   @default(PENDING)
  amountCents Int
  currency    String              @default("EUR")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([provider, externalId])
  @@index([orderId])
}

/// Bestandsbuchungen. Die Eindeutigkeit (orderId, sku, reason) macht die Abbuchung je Bestellung idempotent.
model ShopStockMovement {
  id        String     @id @default(cuid())
  sku       String
  delta     Int
  reason    String
  orderId   String?
  order     ShopOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())

  @@unique([orderId, sku, reason])
  @@index([sku, createdAt])
}
